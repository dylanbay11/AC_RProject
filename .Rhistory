par(mfrow = c(1, 3))
barplot(table(sums) / length(sums), main = "OG problem")
barplot(table(newsums) / length(newsums), main = "Draw last 2 randomly after")
barplot(table(altsums) / length(altsums), main = "Re-draw non-compliant group")
par(mfrow = c(1, 3))
barplot(table(sums) / length(sums), main = "OG problem")
barplot(table(newsums) / length(newsums), main = "Draw last 2 randomly later")
barplot(table(altsums) / length(altsums), main = "Re-draw bad groups")
par(mfrow = c(1, 3))
barplot(table(newsums) / length(newsums), main = "Draw last 2 randomly later")
barplot(table(sums) / length(sums), main = "OG problem")
