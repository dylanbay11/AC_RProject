atkdef <- apply(combos, FUN = stupid()
atkdef <- apply(combos, FUN = stupid())
return(temp)
stupid <- function(list) {
temp <- c()
append(temp,cat(list[,1], list[,2], sep = " A vs D "))
return(temp)
}
atkdef <- apply(combos, FUN = stupid())
